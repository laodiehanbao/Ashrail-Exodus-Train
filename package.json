{
  "name": "ashrail-exodus-train",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx tests/unit/runAllTests.ts",
    "demo": "tsx src/app/runPrototypeCli.ts",
    "sim:loot": "tsx tests/simulations/lootDistribution.sim.ts",
    "sim:combat": "tsx tests/simulations/combatPower.sim.ts",
